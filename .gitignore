# Module Federation writes remote .d.ts files here when dts is enabled. It is
# disabled, but a stray one must never be committed: it is generated code, and
# it makes a typecheck depend on a remote being reachable.
@mf-types/

.DS_Store
*.local
.env
.env.*

# Generated drawing sets and tile pyramids. Reproduced from a seed by
# `pnpm setgen`, so the bytes do not belong in git; the committed manifest
# carries a checksum per sheet so a regenerated set can be verified against it.
data/

# Playwright output. Readings are transcribed into docs/perf/ by hand.
test-results/
playwright-report/

coverage/
*.log
extras
